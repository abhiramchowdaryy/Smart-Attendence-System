# ── Supabase ─────────────────────────────────────────────────────────
# Create a free project at https://supabase.com, then copy these from
# Project Settings → API. Paste into .env.local (never commit .env.local).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Server-only — used by admin tasks / seeding. NEVER prefix with NEXT_PUBLIC_
# and never commit the real value anywhere (this file included).
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# ── Face verification service (optional hardening — FastAPI + DeepFace) ─
# Leave unset: in-browser descriptor capture + server-side matching is used.
# FACE_SERVICE_URL=https://your-face-service.onrender.com

# ── Twilio SMS (planned) ─────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
