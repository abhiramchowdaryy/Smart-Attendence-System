# Face service configuration — copy to .env for local runs (never commit .env).
# Every value has a default; the service boots with none of these set.

# Shared secret. When set, callers must send it as the X-Face-Service-Token
# header. Set the SAME value as FACE_SERVICE_TOKEN in the Next.js app so the two
# sides agree. Leave blank only for local development.
FACE_SERVICE_TOKEN=

# Model + detector. Facenet512 + opencv is a good CPU/free-tier balance.
# FACE_MODEL=Facenet512
# FACE_DETECTOR=opencv
# FACE_DISTANCE_METRIC=cosine

# Raise if no face is found (recommended true for attendance).
# FACE_ENFORCE_DETECTION=true

# Warm the model at startup so the first request isn't slow.
# FACE_WARM_ON_STARTUP=true

# Where DeepFace caches downloaded model weights.
# DEEPFACE_HOME=/var/deepface
